#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
cd "$PROJECT_ROOT"

SKIP_REMOTE=0
if [[ "${1:-}" == "--local" || "${LUNA_CHECK_SKIP_REMOTE:-0}" == "1" ]]; then
  SKIP_REMOTE=1
fi

python3 - "$PROJECT_ROOT" <<'PY'
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1])
errors = []

SKIP_DIRS = {".git", ".build", ".build-linux", "DerivedData", "SourcePackages", "build", "build-tests", "build-vision", ".ci-screenshots"}

for p in sorted(root.rglob("*")):
    if p.is_symlink() or any(part in SKIP_DIRS for part in p.parts):
        continue
    rel = p.relative_to(root).as_posix()
    mode = p.stat().st_mode & 0o777
    if p.is_dir():
        if mode != 0o755:
            errors.append(f"DIR  {rel}: expected 0755, got 0{mode:o}")
    elif p.is_file():
        is_exec_script = rel.startswith("ops/bin/") or (rel.startswith("scripts/") and rel.endswith(".sh"))
        expected = 0o755 if is_exec_script else 0o644
        if mode != expected:
            errors.append(f"FILE {rel}: expected 0{expected:o}, got 0{mode:o}")

swift_roots = [root / "Sources", root / "Tests", root / "Packages"]
swift_files = []
for base in swift_roots:
    if base.exists():
        swift_files.extend(sorted(base.rglob("*.swift")))

RETIRED_IDENT_RE = re.compile(
    r"\bBFF[A-Za-z0-9_]*|CatScale|\bCatCompanion[A-Za-z0-9_]*|\bV250[A-Za-z0-9_]*|[A-Za-z0-9_]*FixesTests\b|\b[A-Za-z0-9_]*ForTesting\b|\bnativeAudioActivatorForTesting\b"
)

for sf in swift_files:
    rel = sf.relative_to(root).as_posix()
    text = sf.read_text(encoding="utf-8", errors="replace")
    lines = len(text.splitlines())
    if lines > 800:
        errors.append(f"LOC  {rel}: {lines} lines exceeds 800 LOC budget")
    if "Bundle.main.bundleIdentifier" in text:
        errors.append(f"SIDELOAD {rel}: forbidden Bundle.main.bundleIdentifier reference")
    if RETIRED_IDENT_RE.search(text):
        errors.append(f"RETIRED {rel}: forbidden legacy/test-closure identifier")
    if "PlayerSheets" in text or "Watchlist/" in text:
        errors.append(f"RETIRED {rel}: forbidden retired Watchlist/ or PlayerSheets reference")
    if re.search(r"\.navigationBarTitleDisplayMode\b|\bUIScreen\.main\b|\bSlider\s*\(", text):
        errors.append(f"TVOS_GUARDRAIL {rel}: forbidden iOS-only SwiftUI/UIKit API (.navigationBarTitleDisplayMode / UIScreen.main / Slider)")
    if re.search(r"\.(?:ultraThinMaterial|thinMaterial|regularMaterial|thickMaterial|ultraThickMaterial)\b", text):
        errors.append(f"TVOS_GUARDRAIL {rel}: forbidden cold system Material blur (.ultraThinMaterial/.regularMaterial/...); use explicit warm Lampelys surfaces")

RETIRED_NAME_RE = re.compile(r"Cat(?!alog|egory)|V250|FixesTests|^BFF|^PlayerSheets")

for check_dir in [root / "Sources", root / "Tests", root / "Packages"]:
    if not check_dir.exists():
        continue
    for item in check_dir.rglob("*"):
        if any(part in SKIP_DIRS for part in item.parts):
            continue
        name = item.name
        rel = item.relative_to(root).as_posix()
        if name == "Watchlist" or RETIRED_NAME_RE.search(name):
            errors.append(f"RETIRED_PATH {rel}: retired leftover file/directory")

PRIVATE_IP_RE = re.compile(
    r"\b(?:10\.\d{1,3}|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])|192\.168|172\.(?:1[6-9]|2\d|3[01]))\.\d{1,3}\.\d{1,3}\b"
)
NAS_PATH_RE = re.compile(r"/volume[12](?=[^0-9A-Za-z_-]|$)")
SECRET_LITERAL_RE = re.compile(r"luna_tv_|skogsrudveien|\.ts\.net", re.IGNORECASE)
RETIRED_BRAND_RE = re.compile(r"mediaos|media[-_]core", re.IGNORECASE)

TEXT_EXTS = {".swift", ".yml", ".yaml", ".md", ".plist", ".json", ".txt", ".sh", ".py", ".html", ".css"}
scan_targets = [
    root / "Sources",
    root / "Tests",
    root / "Packages",
    root / "Config",
    root / "Resources",
    root / "design",
    root / "preview",
    root / "docs",
    root / "ops",
    root / "scripts",
    root / ".github",
    root / "Package.swift",
    root / "project.yml",
    *sorted(root.glob("*.md")),
]

for target in scan_targets:
    if not target.exists():
        continue
    candidates = [target] if target.is_file() else sorted(target.rglob("*"))
    for f in candidates:
        if not f.is_file() or f.is_symlink() or any(part in SKIP_DIRS for part in f.parts):
            continue
        rel = f.relative_to(root).as_posix()
        if rel == "ops/bin/luna-check":
            continue
        if f.suffix.lower() not in TEXT_EXTS and f.name not in {"luna-check", "LICENSE"}:
            continue
        content = f.read_text(encoding="utf-8", errors="replace")
        if PRIVATE_IP_RE.search(content):
            errors.append(f"HYGIENE {rel}: private IP address literal found")
        if NAS_PATH_RE.search(content):
            errors.append(f"HYGIENE {rel}: NAS filesystem path found")
        if SECRET_LITERAL_RE.search(content):
            errors.append(f"HYGIENE {rel}: internal domain or token prefix found")
        if RETIRED_BRAND_RE.search(content):
            errors.append(f"RETIRED {rel}: retired legacy brand reference found")

map_file = root / "docs/architecture/CODEBASE_MODULE_MAP.md"
if not map_file.is_file():
    errors.append("DOC_PARITY missing docs/architecture/CODEBASE_MODULE_MAP.md")
else:
    map_text = map_file.read_text(encoding="utf-8", errors="replace")
    doc_refs = set(
        re.findall(
            r"`((?:Sources|Tests|Packages)/[A-Za-z0-9_.+-]+(?:/[A-Za-z0-9_.+-]+)*\.swift)`",
            map_text,
        )
    )
    for ref in sorted(doc_refs):
        if not (root / ref).is_file():
            errors.append(f"DOC_PARITY {ref}: documented in CODEBASE_MODULE_MAP.md but missing on disk")
    expected_swift = {
        p.relative_to(root).as_posix()
        for p in sorted(
            [
                *(root / "Sources").rglob("*.swift"),
                *(root / "Tests/LunaTests").glob("*.swift"),
                *(root / "Tests/LunaCoreTests").glob("*.swift"),
                *(root / "Packages/AetherBridge/Sources").rglob("*.swift"),
            ]
        )
        if p.is_file()
    }
    for rel in sorted(expected_swift - doc_refs):
        errors.append(f"DOC_PARITY {rel}: exists on disk but undocumented in CODEBASE_MODULE_MAP.md")

import json

xcstrings_path = root / "Resources/Localizable.xcstrings"
xc_keys = set()
if not xcstrings_path.is_file():
    errors.append("COPY_GATE missing Resources/Localizable.xcstrings")
else:
    try:
        xc_data = json.loads(xcstrings_path.read_text(encoding="utf-8"))
        if xc_data.get("sourceLanguage") != "nb" or not isinstance(xc_data.get("strings"), dict) or len(xc_data["strings"]) < 4:
            errors.append("COPY_GATE Resources/Localizable.xcstrings must declare sourceLanguage='nb' with plural entries")
        else:
            xc_keys = set(xc_data["strings"].keys())
    except Exception as exc:
        errors.append(f"COPY_GATE invalid Localizable.xcstrings JSON: {exc}")

tokens_path = root / "design/tokens.json"
if not tokens_path.is_file():
    errors.append("TYPO_FLOOR missing design/tokens.json")
else:
    try:
        tokens_data = json.loads(tokens_path.read_text(encoding="utf-8"))
        def _find_legacy_keys(obj, prefix=""):
            found = []
            if isinstance(obj, dict):
                for k, v in obj.items():
                    kp = f"{prefix}.{k}" if prefix else str(k)
                    if str(k).lower().endswith("legacy"):
                        found.append(kp)
                    found.extend(_find_legacy_keys(v, kp))
            return found
        legacy_keys = _find_legacy_keys(tokens_data)
        if legacy_keys:
            errors.append(f"TOKENS_GATE design/tokens.json contains forbidden *Legacy keys: {', '.join(legacy_keys)}")
        tvos_typo = tokens_data.get("platform", {}).get("tvos", {}).get("typography", {})
        if not tvos_typo:
            errors.append("TYPO_FLOOR missing platform.tvos.typography in design/tokens.json")
        for role_name, pt_val in sorted(tvos_typo.items()):
            if not isinstance(pt_val, (int, float)) or float(pt_val) < 22.0:
                errors.append(f"TYPO_FLOOR design/tokens.json platform.tvos.typography.{role_name}={pt_val} < 22.0 pt minimum")
    except Exception as exc:
        errors.append(f"TYPO_FLOOR invalid design/tokens.json: {exc}")

# Version parity & preview hygiene gate
version_path = root / "VERSION"
if not version_path.is_file():
    errors.append("VERSION_GATE missing VERSION file")
else:
    app_ver = version_path.read_text(encoding="utf-8").strip()
    if not re.match(r"^\d+\.\d+\.\d+$", app_ver):
        errors.append(f"VERSION_GATE invalid VERSION '{app_ver}' (expected semver X.Y.Z)")
    else:
        proj_yml = (root / "project.yml").read_text(encoding="utf-8")
        m_proj = re.search(r'^\s*MARKETING_VERSION:\s*"([^"]+)"', proj_yml, re.MULTILINE)
        if not m_proj or m_proj.group(1) != app_ver:
            errors.append(f"VERSION_GATE project.yml MARKETING_VERSION={m_proj.group(1) if m_proj else 'missing'} != VERSION ({app_ver})")
        storage_swift = (root / "Sources/Core/Config/SideloadSafeStorage.swift").read_text(encoding="utf-8")
        m_stor = re.search(r'appMarketingVersion\s*=\s*"([^"]+)"', storage_swift)
        if not m_stor or m_stor.group(1) != app_ver:
            errors.append(f"VERSION_GATE SideloadSafeStorage.appMarketingVersion={m_stor.group(1) if m_stor else 'missing'} != VERSION ({app_ver})")
        fixtures_swift = (root / "Sources/App/PreviewMockFixtures.swift").read_text(encoding="utf-8")
        m_fix = re.search(r'appVersion:\s*"([^"]+)"', fixtures_swift)
        if not m_fix or m_fix.group(1) != app_ver:
            errors.append(f"VERSION_GATE PreviewMockFixtures.swift appVersion={m_fix.group(1) if m_fix else 'missing'} != VERSION ({app_ver})")

if (root / "preview/tokens.json").exists():
    errors.append("PREVIEW_GATE retired preview/tokens.json must not exist; use generated preview/tokens.css")
if not (root / "preview/tokens.css").is_file():
    errors.append("PREVIEW_GATE missing generated preview/tokens.css")
preview_html = root / "preview/index.html"
if preview_html.is_file():
    html_txt = preview_html.read_text(encoding="utf-8")
    if "./tokens.css" not in html_txt:
        errors.append("PREVIEW_GATE preview/index.html must link ./tokens.css")
    if "tokens.json" in html_txt:
        errors.append("PREVIEW_GATE preview/index.html must not reference retired tokens.json")

PLURAL_BUG_RE = re.compile(r"\\\([^)]+\)\s*(?:lokale\s+|aktive\s+)?(?:filmer|serier|episoder|sesonger|tjenester|titler|kilder|dager|mediefiler|festet|kapitler|treff)\b")
RAW_FONT_STYLE_RE = re.compile(r"\.font\(\.(?:caption2?|footnote|subheadline|callout|body|headline|title[23]?|largeTitle)\b")
sys_font_calls = 0
typo_sizes_checked = 0
all_sources_concat = []

for sf in sorted((root / "Sources").rglob("*.swift")):
    rel = sf.relative_to(root).as_posix()
    text = sf.read_text(encoding="utf-8", errors="replace")
    all_sources_concat.append(text)
    sys_font_calls += len(re.findall(r"\.font\(\.system\(size:", text))
    if RAW_FONT_STYLE_RE.search(text):
        errors.append(f"TYPO_FLOOR {rel}: raw SwiftUI text style (.font(.caption/.title/...)) forbidden; use LunaTheme.Font.*")
    if rel == "Sources/DesignSystem/LunaThemeTypography.swift":
        for m in re.finditer(r"size:\s*(\d+(?:\.\d+)?)", text):
            pt = float(m.group(1))
            typo_sizes_checked += 1
            if pt < 22.0:
                errors.append(f"TYPO_FLOOR {rel}: font size {pt} pt is below 22.0 pt tvOS floor")
        for _ in re.finditer(r"size:\s*LunaTokens\.Typography\.[A-Za-z0-9_]+", text):
            typo_sizes_checked += 1
    else:
        if re.search(r"Font\.system\s*\(", text) or re.search(r"\.font\(\s*\.system\s*\(", text):
            errors.append(f"TYPO_FLOOR {rel}: direct .system(...) font outside LunaThemeTypography.swift")
    for i, ln in enumerate(text.splitlines(), 1):
        if PLURAL_BUG_RE.search(ln):
            errors.append(f"COPY_GATE {rel}:{i}: hardcoded Norwegian plural interpolation")
        if "mediefil" in ln and "? \"l\"" in ln:
            errors.append(f"COPY_GATE {rel}:{i}: inline ternary plural hack")

if typo_sizes_checked < 15:
    errors.append(f"TYPO_FLOOR expected >= 15 typography definitions in LunaThemeTypography.swift, found {typo_sizes_checked}")

joined_sources = "\n".join(all_sources_concat)
for key in sorted(xc_keys):
    prefix = key.split(" ")[0]
    if prefix not in joined_sources:
        errors.append(f"COPY_GATE Resources/Localizable.xcstrings key '{key}' is unused in Sources/")

if sys_font_calls > 0:
    errors.append(f"RATCHET .font(.system(size: count {sys_font_calls} exceeds M8 0 ceiling")

if errors:
    print("LUNA-CHECK FAILED:", file=sys.stderr)
    for err in errors:
        print(f"  - {err}", file=sys.stderr)
    sys.exit(1)

print(f"  [OK] Permissions (0755/0644), <= 800 LOC ({len(swift_files)} .swift files), doc parity ({len(doc_refs)} modules), sideload, retired patterns, copy/ratchet ({sys_font_calls}<=0) & public hygiene checks passed")
PY

python3 -B "$SCRIPT_DIR/luna-design-tokens" --check

if [[ "$SKIP_REMOTE" -eq 0 ]] && command -v git >/dev/null 2>&1 && git -C "$PROJECT_ROOT" remote get-url origin >/dev/null 2>&1; then
  REMOTE_TAGS=""
  if command -v timeout >/dev/null 2>&1; then
    if REMOTE_TAGS="$(GIT_TERMINAL_PROMPT=0 timeout 8 git -C "$PROJECT_ROOT" ls-remote --tags origin 2>/dev/null)"; then
      if printf '%s\n' "$REMOTE_TAGS" | grep -q 'refs/tags/nas/'; then
        echo "LUNA-CHECK FAILED: remote origin contains forbidden nas/* tag(s)!" >&2
        printf '%s\n' "$REMOTE_TAGS" | grep 'refs/tags/nas/' >&2
        exit 1
      fi
      echo "  [OK] origin remote tags contain zero nas/* tags"
    else
      echo "  [WARN] Could not reach origin to verify remote tags; local tag hygiene only" >&2
    fi
  else
    if REMOTE_TAGS="$(GIT_TERMINAL_PROMPT=0 git -C "$PROJECT_ROOT" ls-remote --tags origin 2>/dev/null)"; then
      if printf '%s\n' "$REMOTE_TAGS" | grep -q 'refs/tags/nas/'; then
        echo "LUNA-CHECK FAILED: remote origin contains forbidden nas/* tag(s)!" >&2
        printf '%s\n' "$REMOTE_TAGS" | grep 'refs/tags/nas/' >&2
        exit 1
      fi
      echo "  [OK] origin remote tags contain zero nas/* tags"
    else
      echo "  [WARN] Could not reach origin to verify remote tags; local tag hygiene only" >&2
    fi
  fi
fi

echo "==> Luna luna-check bestått."
